{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Physical hardware and building-materials retail inventory item.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated shop owner UID."
        },
        "itemCode": {
          "type": "string",
          "description": "Unique item code (4 to 9 characters)."
        },
        "name": {
          "type": "string",
          "description": "Product name."
        },
        "brand": {
          "type": "string",
          "description": "Optional brand name (e.g., Astral, Taparia)."
        },
        "sizeSpec": {
          "type": "string",
          "description": "Optional size, gauge, or specification."
        },
        "category": {
          "type": "string",
          "enum": [
            "Pipes & Plumbing",
            "Iron Rods & Steel",
            "Nuts, Bolts & Screws",
            "Taps & Sanitary",
            "Building Materials",
            "Tools",
            "Tools & Accessories",
            "Other Hardware"
          ]
        },
        "unit": {
          "type": "string",
          "enum": ["Piece", "Kg", "Feet", "Meter", "Metre", "Box", "Packet", "Bundle", "Tonne"]
        },
        "purchasePrice": {
          "type": "number",
          "description": "Latest purchase cost per unit in INR."
        },
        "averageCost": {
          "type": "number",
          "description": "Weighted average cost per unit in INR."
        },
        "sellingPrice": {
          "type": "number",
          "description": "Selling price per unit in INR."
        },
        "stockQty": {
          "type": "number",
          "description": "Current available stock quantity (>= 0)."
        },
        "lowStockLimit": {
          "type": "number",
          "description": "Threshold at or below which low stock alert triggers."
        },
        "description": {
          "type": "string",
          "description": "Shopkeeper notes (rack location, brand, material) saved verbatim."
        },
        "imageDataUrl": {
          "type": "string",
          "description": "Compressed JPEG base64 data URL (max 600x600px, <= 120 KB)."
        },
        "archived": {
          "type": "boolean",
          "description": "True when archived by the shopkeeper."
        },
        "isDemo": {
          "type": "boolean",
          "description": "True when generated by Load Sample Shop Data."
        },
        "demoBatchId": {
          "type": "string",
          "description": "Stable demo batch identifier."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "itemCode",
        "name",
        "category",
        "unit",
        "purchasePrice",
        "averageCost",
        "sellingPrice",
        "stockQty",
        "lowStockLimit",
        "isDemo",
        "createdAt",
        "updatedAt"
      ]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Stock-in purchase ledger record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "itemCode": { "type": "string" },
        "unit": { "type": "string" },
        "quantity": { "type": "number" },
        "unitPrice": { "type": "number" },
        "totalAmount": { "type": "number" },
        "partyName": { "type": "string" },
        "paymentMode": { "type": "string", "enum": ["Cash", "UPI", "Credit"] },
        "billGroupId": { "type": "string" },
        "transactionAt": { "type": "string", "format": "date-time" },
        "isDemo": { "type": "boolean" },
        "demoBatchId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "productId", "productName", "itemCode", "unit",
        "quantity", "unitPrice", "totalAmount", "paymentMode",
        "transactionAt", "isDemo", "createdAt"
      ]
    },
    "Sale": {
      "title": "Sale",
      "description": "Stock-out sale ledger record with unitCostAtSale snapshot.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "itemCode": { "type": "string" },
        "unit": { "type": "string" },
        "quantity": { "type": "number" },
        "unitSellingPrice": { "type": "number" },
        "unitCostAtSale": { "type": "number" },
        "totalAmount": { "type": "number" },
        "estimatedProfit": { "type": "number" },
        "partyName": { "type": "string" },
        "paymentMode": { "type": "string", "enum": ["Cash", "UPI", "Credit"] },
        "billGroupId": { "type": "string" },
        "transactionAt": { "type": "string", "format": "date-time" },
        "isDemo": { "type": "boolean" },
        "demoBatchId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "productId", "productName", "itemCode", "unit",
        "quantity", "unitSellingPrice", "unitCostAtSale", "totalAmount",
        "estimatedProfit", "paymentMode", "transactionAt", "isDemo", "createdAt"
      ]
    },
    "StockAdjustment": {
      "title": "StockAdjustment",
      "description": "Audited manual stock correction, damage write-off, or return record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "itemCode": { "type": "string" },
        "unit": { "type": "string" },
        "previousQty": { "type": "number" },
        "adjustmentDelta": { "type": "number" },
        "resultingQty": { "type": "number" },
        "reason": {
          "type": "string",
          "enum": [
            "Opening Stock",
            "Damaged Goods",
            "Physical Correction",
            "Customer Return",
            "Supplier Return"
          ]
        },
        "notes": { "type": "string" },
        "transactionAt": { "type": "string", "format": "date-time" },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "productId", "productName", "itemCode", "unit",
        "previousQty", "adjustmentDelta", "resultingQty", "reason",
        "transactionAt", "isDemo", "createdAt"
      ]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Shop hardware inventory products owned by the authenticated shopkeeper."
    },
    "/purchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/Purchase" },
      "description": "Stock-in purchase records owned by the authenticated shopkeeper."
    },
    "/sales/{saleId}": {
      "schema": { "$ref": "#/entities/Sale" },
      "description": "Stock-out sale records owned by the authenticated shopkeeper."
    },
    "/stock_adjustments/{adjustmentId}": {
      "schema": { "$ref": "#/entities/StockAdjustment" },
      "description": "Audited stock adjustment logs owned by the authenticated shopkeeper."
    }
  }
}
